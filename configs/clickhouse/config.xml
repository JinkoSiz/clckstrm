<?xml version="1.0"?>
<clickhouse>
    <logger>
        <level>information</level>
        <console>true</console>
    </logger>

    <remote_servers>
        <clickstream_cluster>
            <shard>
                <replica>
                    <host>clickhouse-1</host>
                    <port>9000</port>
                    <user>clickstream</user>
                    <password>clickstream123</password>
                </replica>
                <replica>
                    <host>clickhouse-2</host>
                    <port>9000</port>
                    <user>clickstream</user>
                    <password>clickstream123</password>
                </replica>
            </shard>
        </clickstream_cluster>
    </remote_servers>

    <zookeeper>
        <node>
            <host>zookeeper</host>
            <port>2181</port>
        </node>
    </zookeeper>

    <distributed_ddl>
        <path>/clickhouse/task_queue/ddl</path>
    </distributed_ddl>
</clickhouse>
