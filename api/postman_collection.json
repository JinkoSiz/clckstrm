{
  "info": {
    "_postman_id": "clickstream-analytics-api",
    "name": "Clickstream Analytics API",
    "description": "API collection for Clickstream Analytics system.\n\n## Base URL\n- Local: http://localhost:8000\n\n## Authentication\nNo authentication required for demo purposes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/health",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "health"]
            },
            "description": "Basic health check endpoint."
          },
          "response": [
            {
              "name": "Success",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"status\": \"ok\"\n}"
            }
          ]
        },
        {
          "name": "Detailed Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/health/detailed",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "health", "detailed"]
            },
            "description": "Detailed health check for all components (ClickHouse, PostgreSQL, Kafka)."
          },
          "response": [
            {
              "name": "All Healthy",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"status\": \"healthy\",\n  \"components\": {\n    \"clickhouse\": {\n      \"status\": \"healthy\",\n      \"message\": \"Connected\"\n    },\n    \"postgres\": {\n      \"status\": \"healthy\",\n      \"message\": \"Connected\"\n    },\n    \"kafka_consumer\": {\n      \"status\": \"healthy\",\n      \"message\": \"Running\"\n    }\n  }\n}"
            }
          ]
        },
        {
          "name": "Liveness Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/live",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "live"]
            },
            "description": "Kubernetes-style liveness probe."
          },
          "response": [
            {
              "name": "Alive",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"status\": \"alive\"\n}"
            }
          ]
        },
        {
          "name": "Readiness Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/ready",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "ready"]
            },
            "description": "Kubernetes-style readiness probe."
          },
          "response": [
            {
              "name": "Ready",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"status\": \"ready\"\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Events",
      "item": [
        {
          "name": "Create Events (Batch)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"events\": [\n    {\n      \"type\": \"view\",\n      \"session_id\": \"sess-abc123\",\n      \"user_id\": 1001,\n      \"url\": \"/catalog/phones\",\n      \"referrer\": \"/home\",\n      \"device_type\": \"desktop\",\n      \"user_agent\": \"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36\"\n    },\n    {\n      \"type\": \"click\",\n      \"session_id\": \"sess-abc123\",\n      \"user_id\": 1001,\n      \"url\": \"/catalog/phones\",\n      \"payload\": {\n        \"event_title\": \"add_to_cart\",\n        \"element_id\": \"#buy-btn\",\n        \"x\": 445,\n        \"y\": 315\n      }\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/events",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "events"]
            },
            "description": "Create multiple events in a single batch request."
          },
          "response": [
            {
              "name": "Success",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"status\": \"ok\",\n  \"processed\": 2,\n  \"errors\": []\n}"
            }
          ]
        },
        {
          "name": "Create Single View Event",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"events\": [\n    {\n      \"type\": \"view\",\n      \"session_id\": \"sess-xyz789\",\n      \"url\": \"/products/iphone-15\",\n      \"referrer\": \"/catalog\",\n      \"device_type\": \"mobile\",\n      \"user_agent\": \"Mozilla/5.0 (iPhone; CPU iPhone OS 17_0 like Mac OS X)\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/events",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "events"]
            },
            "description": "Create a single page view event."
          },
          "response": [
            {
              "name": "Success",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"status\": \"ok\",\n  \"processed\": 1,\n  \"errors\": []\n}"
            }
          ]
        },
        {
          "name": "Create Click Event with Coordinates",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"events\": [\n    {\n      \"type\": \"click\",\n      \"session_id\": \"sess-xyz789\",\n      \"url\": \"/products/iphone-15\",\n      \"payload\": {\n        \"event_title\": \"buy_now\",\n        \"element_id\": \"#purchase-button\",\n        \"x\": 250,\n        \"y\": 480\n      }\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/events",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "events"]
            },
            "description": "Create a click event with element coordinates."
          },
          "response": [
            {
              "name": "Success",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"status\": \"ok\",\n  \"processed\": 1,\n  \"errors\": []\n}"
            }
          ]
        },
        {
          "name": "Get Events (All)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/events?limit=100&offset=0",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "events"],
              "query": [
                {
                  "key": "limit",
                  "value": "100"
                },
                {
                  "key": "offset",
                  "value": "0"
                }
              ]
            },
            "description": "Get all events with pagination."
          },
          "response": [
            {
              "name": "Success",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"events\": [],\n  \"total\": 0,\n  \"limit\": 100,\n  \"offset\": 0\n}"
            }
          ]
        },
        {
          "name": "Get Events (By User)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/events?user_id=1001&limit=50",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "events"],
              "query": [
                {
                  "key": "user_id",
                  "value": "1001"
                },
                {
                  "key": "limit",
                  "value": "50"
                }
              ]
            },
            "description": "Get events filtered by user ID."
          },
          "response": []
        },
        {
          "name": "Get Events (By Type)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/events?type=click&limit=50",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "events"],
              "query": [
                {
                  "key": "type",
                  "value": "click"
                },
                {
                  "key": "limit",
                  "value": "50"
                }
              ]
            },
            "description": "Get events filtered by event type."
          },
          "response": []
        },
        {
          "name": "Get Events (By Date Range)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/events?from=2025-01-01&to=2025-01-31&limit=100",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "events"],
              "query": [
                {
                  "key": "from",
                  "value": "2025-01-01"
                },
                {
                  "key": "to",
                  "value": "2025-01-31"
                },
                {
                  "key": "limit",
                  "value": "100"
                }
              ]
            },
            "description": "Get events filtered by date range."
          },
          "response": []
        },
        {
          "name": "Get Events (Combined Filters)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/events?user_id=1001&type=click&from=2025-01-01&to=2025-01-31&limit=50&offset=0",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "events"],
              "query": [
                {
                  "key": "user_id",
                  "value": "1001"
                },
                {
                  "key": "type",
                  "value": "click"
                },
                {
                  "key": "from",
                  "value": "2025-01-01"
                },
                {
                  "key": "to",
                  "value": "2025-01-31"
                },
                {
                  "key": "limit",
                  "value": "50"
                },
                {
                  "key": "offset",
                  "value": "0"
                }
              ]
            },
            "description": "Get events with multiple filters combined."
          },
          "response": []
        }
      ]
    },
