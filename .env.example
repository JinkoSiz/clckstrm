# =============================================================================
# Clickstream Analytics - Environment Variables
# =============================================================================

# ClickHouse
CLICKHOUSE_HOST=clickhouse-1
CLICKHOUSE_PORT=9000
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_USER=clickstream
CLICKHOUSE_PASSWORD=clickstream123
CLICKHOUSE_DATABASE=clickstream

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=clickstream
POSTGRES_PASSWORD=clickstream123
POSTGRES_DATABASE=clickstream

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka-1:29092,kafka-2:29092,kafka-3:29092
KAFKA_TOPIC=clickstream-events
KAFKA_GROUP_ID=clickstream-consumer

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEBUG=true
LOG_LEVEL=INFO

# Generator
EVENTS_PER_SECOND=10

# Airflow
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Superset
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=admin
